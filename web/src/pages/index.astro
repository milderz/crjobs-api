---
import Base from '../layouts/Base.astro';
---

<Base title="Find your next job">
  <section class="hero">
    <h1>Empleos en Costa Rica</h1>
    <p>Agregados diariamente desde varios portales de empleo</p>
  </section>

  <form class="filters" id="filters">
    <input type="search" id="q" placeholder="Buscar puesto o empresa" aria-label="Buscar trabajos" />
    <select id="portal" aria-label="Empresa">
      <option value="">Empresas</option>
      <option value="amazon">Amazon</option>
      <option value="hpe">HPE</option>
      <option value="accenture">Accenture</option>
    </select>
    <input type="text" id="location" placeholder="Ubicación" aria-label="Ubicación" />
    <button type="submit">Buscar</button>
  </form>

  <div id="status" class="state" hidden>
    <div class="spinner"></div>
    <p>Cargando empleos…</p>
  </div>

  <div id="error" class="state" hidden>
    <p>No se pudieron cargar los empleos. La API puede estar iniciando — intenta de nuevo en un momento.</p>
    <button class="filters button" id="retry" type="button">Reintentar</button>
  </div>

  <div id="empty" class="state" hidden>
    <p>No se encontraron empleos. Prueba con otros filtros o vuelve después del próximo rastreo.</p>
  </div>

  <div class="jobs-grid" id="jobs"></div>

  <button class="load-more" id="loadMore" hidden>Cargar más</button>
</Base>

<script>
  const API = import.meta.env.PUBLIC_API_URL || '';
  const PAGE_SIZE = 50;

  const PORTAL_LOGOS = {
    amazon: '/amazon_logo.jfif',
    hpe: '/hpe.jfif',
    accenture: '/accenture_logo.jfif',
  };

  const jobsEl = document.getElementById('jobs')!;
  const statusEl = document.getElementById('status')!;
  const errorEl = document.getElementById('error')!;
  const emptyEl = document.getElementById('empty')!;
  const loadMoreBtn = document.getElementById('loadMore')!;
  const form = document.getElementById('filters') as HTMLFormElement;

  let offset = 0;
  let total = 0;
  let loading = false;

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  const SAVED_KEY = 'savedJobs';
  function getSaved(): Set<string> {
    try { return new Set(JSON.parse(localStorage.getItem(SAVED_KEY) || '[]')); }
    catch { return new Set(); }
  }
  function toggleSaved(key: string) {
    const saved = getSaved();
    saved.has(key) ? saved.delete(key) : saved.add(key);
    localStorage.setItem(SAVED_KEY, JSON.stringify([...saved]));
  }

  function jobCard(job: any) {
    const raw = (job.summary || job.description || '').replace(/\s+/g, ' ').trim();
    const summary = raw.length > 220 ? raw.slice(0, 220).replace(/\s+\S*$/, '') + '…' : raw;
    const detailUrl = `/job?portal=${encodeURIComponent(job.portal)}&id=${encodeURIComponent(job.id || job.link)}`;
    const logo = PORTAL_LOGOS[job.portal as keyof typeof PORTAL_LOGOS];
    const key = `${job.portal}:${job.id}`;
    const saved = getSaved().has(key) ? 'saved' : '';
    const posted = job.scrapedAt ? new Date(job.scrapedAt).toLocaleDateString() : '';
    return `
      <article class="job-card">
        <div class="card-header">
          ${logo ? `<img class="job-logo" src="${logo}" alt="${escapeHtml(job.company || job.portal)}" loading="lazy" />` : ''}
          <button class="save-btn ${saved}" data-key="${escapeHtml(key)}" aria-label="Guardar empleo" title="Guardar empleo">♡</button>
        </div>
        <div class="card-submeta">
          <span class="company-name">${escapeHtml(job.company || job.portal)}</span>
          ${posted ? `<span class="posted">Publicado ${posted}</span>` : ''}
        </div>
        <h3><a href="${detailUrl}">${escapeHtml(job.title)}</a></h3>
        ${summary ? `<p class="summary">${escapeHtml(summary)}</p>` : ''}
        <div class="card-footer">
          ${job.location ? `<span class="location">📍 ${escapeHtml(job.location)}</span>` : '<span></span>'}
          <a class="btn" href="${job.link}" target="_blank" rel="noopener">Ver oferta ↗</a>
        </div>
      </article>`;
  }

  async function fetchJobs(append = false) {
    if (loading) return;
    loading = true;
    statusEl.hidden = false;
    errorEl.hidden = true;

    const params = new URLSearchParams({
      limit: String(PAGE_SIZE),
      offset: String(append ? offset : 0),
    });
    const q = (document.getElementById('q') as HTMLInputElement).value.trim();
    const portal = (document.getElementById('portal') as HTMLSelectElement).value;
    const location = (document.getElementById('location') as HTMLInputElement).value.trim();
    if (q) params.set('q', q);
    if (portal) params.set('portals', portal);
    if (location) params.set('location', location);

    try {
      const res = await fetch(`${API}/api/jobs?${params}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (!append) {
        jobsEl.innerHTML = '';
        offset = 0;
        total = data.total || 0;
      }

      jobsEl.insertAdjacentHTML('beforeend', data.jobs.map(jobCard).join(''));
      offset += data.jobs.length;

      emptyEl.hidden = data.jobs.length > 0 || offset > 0;
      loadMoreBtn.hidden = offset >= total;
    } catch {
      errorEl.hidden = false;
    } finally {
      statusEl.hidden = true;
      loading = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    fetchJobs(false);
  });

  loadMoreBtn.addEventListener('click', () => fetchJobs(true));
  document.getElementById('retry')!.addEventListener('click', () => fetchJobs(false));

  jobsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.save-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const key = btn.dataset.key!;
    toggleSaved(key);
    btn.classList.toggle('saved');
    btn.textContent = btn.classList.contains('saved') ? '♥' : '♡';
  });

  fetchJobs(false);
</script>
