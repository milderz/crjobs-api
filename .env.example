# Environment
PORT=3000

# Cache TTL in milliseconds (default 15 min, live mode only)
CACHE_TTL_MS=900000

# Database file path (default: ./jobs.db)
# DB_PATH=./jobs.db

# Daily scrape schedule (cron syntax, default: 06:00 daily)
SCRAPE_CRON=0 6 * * *
SCRAPE_TIMEZONE=America/Costa_Rica
SCRAPE_LOCATION=costa-rica
SCRAPE_MAX_ITEMS=200
SCRAPE_WITH_DETAILS=true
